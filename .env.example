# Copy to .env and edit (or run:  powershell -ExecutionPolicy Bypass -File scripts\setup.ps1)

# Domain that points at THIS server machine. With nip.io, "<anything>.192.168.1.50.nip.io"
# resolves to 192.168.1.50, so every repository gets its own subdomain with no DNS setup.
# Replace 192.168.1.50 with the server machine's LAN IP address.
BASE_DOMAIN=192.168.1.50.nip.io

# Port the platform listens on (dashboard, git, and every deployed app).
HTTP_PORT=80

# Access code for the platform administrator (8+ digits recommended).
ADMIN_CODE=12345678

# Root password for the shared MySQL server (competitors never see it).
MYSQL_ROOT_PASSWORD=change-me-please
MYSQL_PORT=3306

# How many builds run at the same time. Others wait in a visible queue.
BUILD_CONCURRENCY=2

# Parallel package downloads during builds (npm/composer). Leave empty for the defaults.
# Set to 1 if builds hang at "npm install" (happens behind some VPNs/proxies).
NPM_MAXSOCKETS=

# Stop app containers after this many idle minutes; they wake on the next request. 0 = never.
IDLE_MINUTES=30
